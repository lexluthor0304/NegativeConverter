# Bundled into every desktop package as licenses/raw-decoder-notices.txt: keep
# it byte-identical on Windows checkouts, where Git would otherwise write CRLF.
negative2positive/public/licenses/*.txt text eol=lf
# The OpenCV SIMD glue and build information are checked byte for byte at
# build time (assertOpenCvSimdGlue, the build-info SHA-256 in the tests):
# keep them LF on Windows checkouts, and the wasm untouched.
negative2positive/public/codecs/opencv-simd-glue.js text eol=lf
negative2positive/public/codecs/opencv-simd-build-info.txt text eol=lf
negative2positive/public/codecs/opencv-LICENSE.txt text eol=lf
negative2positive/public/codecs/*.wasm binary
# The PNG16 deflate modules and their build information (#301) are held to
# the SHA-256 in the build info by pngDeflateWasm.test.mjs.
negative2positive/src/workers/png-deflate-build-info.txt text eol=lf
negative2positive/src/workers/*.wasm binary
# The vendored LibRaw-Wasm build (#302) is held to BUILD-INFO.txt byte for
# byte (librawVendor.test.mjs): no line-ending conversion on any checkout.
negative2positive/vendor/libraw-wasm/** -text
