{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Negative Converter",
  "version": "1.0.12",
  "identifier": "com.neoanaloglab.negativeconverter",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://127.0.0.1:4173",
    "frontendDist": "../negative2positive/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Negative Converter",
        "width": 1280,
        "height": 850,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' blob: 'wasm-unsafe-eval' 'unsafe-eval' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; style-src-attr 'unsafe-inline'; img-src 'self' blob: data:; font-src 'self' data:; media-src 'self' blob: data:; worker-src 'self' blob:; child-src 'self' blob:; connect-src 'self' blob: data: ipc: http://ipc.localhost https://negative-converter.tokugai.com https://download.neoanaloglab.com https://api.github.com https://cdn.jsdelivr.net; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "entitlements.plist",
      "minimumSystemVersion": "10.15"
    },
    "category": "Photography",
    "shortDescription": "Film negative to positive converter"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcxOUIyQTgyRTUyMURBMTAKUldRUTJpSGxnaXFiY1R1blQvTkF3NkZzYWlTRFJhbkx6dVlPMU9mUHZwQ3l1bEJvZkRHdE41NFIK",
      "endpoints": [
        "https://download.neoanaloglab.com/negative-converter/release/updater.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
