# Mac App Store release lane, driven by the mas-appstore job in
# .github/workflows/desktop-release.yml (see docs/mas-release.md).
#
# Expects environment variables:
#   ASC_API_KEY_ID / ASC_API_ISSUER_ID  - App Store Connect API key identity
#   ASC_API_KEY_P8                      - base64-encoded AuthKey .p8
#   PKG_PATH                            - absolute path to the signed MAS .pkg
#   APP_VERSION                         - CFBundleShortVersionString (x.y.z)
#   RELEASE_NOTES_PATH                  - optional file with "What's New" text

opt_out_usage
default_platform(:mac)

platform :mac do
  desc "Upload the signed .pkg to App Store Connect and submit for review"
  lane :mas_upload do
    # The ASC API key alone only proves identity, not that the caller is
    # authorized to ship a production release. Require an explicit,
    # separately-gated flag so a leaked/valid key cannot submit on its own.
    UI.user_error!("RELEASE_AUTHORIZED must be 'true' to run mas_upload") unless ENV["RELEASE_AUTHORIZED"] == "true"

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_API_KEY_ID"),
      issuer_id: ENV.fetch("ASC_API_ISSUER_ID"),
      key_content: ENV.fetch("ASC_API_KEY_P8"),
      is_key_content_base64: true
    )

    notes = ""
    notes_path = ENV["RELEASE_NOTES_PATH"]
    notes = File.read(notes_path).strip if notes_path && File.exist?(notes_path)
    notes = "Bug fixes and improvements." if notes.empty?

    deliver(
      api_key: api_key,
      app_identifier: "com.neoanaloglab.negativeconverter",
      platform: "osx",
      # deliver reads the build number from the pkg itself; passing
      # build_number alongside pkg is rejected as conflicting options.
      pkg: ENV.fetch("PKG_PATH"),
      app_version: ENV.fetch("APP_VERSION"),
      # Locales must be listed explicitly: with no local metadata folder,
      # deliver treats "default" as a literal language and the real locales
      # never receive whatsNew, which then blocks the review submission.
      # Extend this hash if more App Store locales are ever added.
      release_notes: { "en-US" => notes },
      screenshots_path: File.join(ENV.fetch("GITHUB_WORKSPACE", File.expand_path("..", Dir.pwd)), "fastlane", "screenshots"),
      skip_screenshots: false,
      overwrite_screenshots: true,
      run_precheck_before_submit: false,
      precheck_include_in_app_purchases: false,
      force: true,
      reject_if_possible: true,
      submit_for_review: true,
      automatic_release: true,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false,
        content_rights_contains_third_party_content: false
      }
    )
  end
end

# iOS has its own assets and version sequence. The existing mac lane above is
# unchanged. The workflow selects TestFlight while acceptance is in progress;
# App Store releases submit automatically and go live when Apple approves.
platform :ios do
  desc "Upload an iOS build or submit it for automatic App Store release"
  lane :publish do
    channel = ENV.fetch("IOS_RELEASE_CHANNEL")
    UI.user_error!("Unknown iOS release channel") unless ["testflight", "app-store"].include?(channel)
    repo_root = ENV.fetch("GITHUB_WORKSPACE", File.expand_path("..", __dir__))
    ios_root = File.join(repo_root, "fastlane", "ios")
    if channel == "app-store"
      require "json"
      ready = JSON.parse(File.read(File.join(ios_root, "release.json"))).fetch("appStoreSubmissionReady")
      UI.user_error!("iOS acceptance is incomplete; see docs/ios-release.md") unless ready == true
      sh("node", File.join(repo_root, "scripts", "check-ios-store-assets.mjs"))
    end
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_API_KEY_ID"),
      issuer_id: ENV.fetch("ASC_API_ISSUER_ID"),
      key_content: ENV.fetch("ASC_API_KEY_P8"),
      is_key_content_base64: true
    )
    if channel == "testflight"
      upload_to_testflight(
        api_key: api_key,
        app_identifier: "com.neoanaloglab.negativeconverter",
        apple_id: "6797694070",
        ipa: ENV.fetch("IPA_PATH"),
        distribute_external: false,
        skip_submission: true,
        skip_waiting_for_build_processing: false
      )
    else
      deliver(
        api_key: api_key,
        app_identifier: "com.neoanaloglab.negativeconverter",
        platform: "ios",
        ipa: ENV.fetch("IPA_PATH"),
        app_version: ENV.fetch("APP_VERSION"),
        metadata_path: File.join(ios_root, "metadata"),
        screenshots_path: File.join(ios_root, "screenshots"),
        skip_screenshots: false,
        overwrite_screenshots: true,
        run_precheck_before_submit: false,
        precheck_include_in_app_purchases: false,
        force: true,
        reject_if_possible: false,
        submit_for_review: true,
        automatic_release: true,
        submission_information: {
          add_id_info_uses_idfa: false,
          content_rights_contains_third_party_content: false
        }
      )
    end
  end
end
