{
  "name": "negativeconverter",
  "private": true,
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "http-server": "14.1.1",
    "vite": "^8.2.2"
  },
  "scripts": {
    "dev:web": "vite --config negative2positive/vite.config.js",
